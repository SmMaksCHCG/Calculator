<Window x:Class="calculator1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:calculator1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <!-- Левая часть: экран и кнопки -->
        <Grid Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Экран -->
            <TextBox Name="Display"
                     Grid.Row="0"
                     Height="72"
                     FontSize="28"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Right"
                     IsReadOnly="True"
                     Text="0"
                     Margin="0,0,0,12" />

            <!-- Кнопки -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Первая строка -->
                <Button Grid.Row="0" Grid.Column="0" Content="C" Click="Clear_Click" Margin="4" />
                <Button Grid.Row="0" Grid.Column="1" Content="±" Click="Negate_Click" Margin="4" />
                <Button Grid.Row="0" Grid.Column="2" Content="←" Click="Back_Click" Margin="4" />
                <Button Grid.Row="0" Grid.Column="3" Content="/" Click="Operator_Click" Margin="4" />

                <!-- Цифры и операции -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="1" Grid.Column="3" Content="*" Click="Operator_Click" Margin="4" />

                <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="2" Grid.Column="3" Content="-" Click="Operator_Click" Margin="4" />

                <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="3" Grid.Column="2" Content="3" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="3" Grid.Column="3" Content="+" Click="Operator_Click" Margin="4" />

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Click="Digit_Click" Margin="4" />
                <Button Grid.Row="4" Grid.Column="2" Content="," Click="Decimal_Click" Margin="4" />
                <Button Grid.Row="4" Grid.Column="3" Content="=" Click="Equals_Click" Margin="4" />
            </Grid>
        </Grid>

        <!-- Правая часть: история вычислений -->
        <Border Grid.Column="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="12" Padding="8">
            <DockPanel>
                <TextBlock Text="История" FontWeight="Bold" Margin="0,0,0,8" DockPanel.Dock="Top" />
                <ListBox Name="HistoryListBox" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
