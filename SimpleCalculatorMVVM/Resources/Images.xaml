<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vector calculator icon as DrawingImage (scales and works offline) -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- base rounded rectangle -->
                <GeometryDrawing Brush="#FFF57C00">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- screen -->
                <GeometryDrawing Brush="#FFB3E5FC">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,6,48,16" RadiusX="3" RadiusY="3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- buttons area background -->
                <GeometryDrawing Brush="#FFFFCC80">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="8,26,48,30" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- small buttons -->
                <GeometryDrawing Brush="#FFF06292">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="12,30,12,8" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="28,30,12,8" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="12,40,12,8" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="28,40,12,8" RadiusX="2" RadiusY="2" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- equals button -->
                <GeometryDrawing Brush="#FF7E57C2">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="44,30,10,18" RadiusX="2" RadiusY="2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- screen digits (simple rectangle to simulate display) -->
                <GeometryDrawing Brush="#FF263238">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="44,10,10,8" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Cursor resource (dynamic load possible) -->
    <Cursor x:Key="HandCursor">pack://application:,,,/SimpleCalculatorMVVM;component/Resources/Cursors/hand.cur</Cursor>

</ResourceDictionary>
